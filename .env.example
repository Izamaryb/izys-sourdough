
# PostgreSQL connection string used by Prisma
# For local dev: postgres://USER:PASSWORD@localhost:5432/izys_sourdough
# For production: use the connection string from your hosting provider.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5432/izys_sourdough"

# Admin panel authentication
# ADMIN_PASSWORD is the shared passphrase used to sign in at /admin/login.
# ADMIN_SESSION_SECRET signs the admin session cookie; use a long random string.
# Generate one with: openssl rand -hex 32
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Customer email (SMTP via Gmail)
# For local development, copy these into .env.local (or .env) and fill in real values.
# .env.example is NOT loaded by Next.js and should never hold real credentials.
#
# Setup steps for Gmail:
#   1. Use (or create) a Gmail account dedicated to sending order emails, e.g. orders@yourdomain
#      or a plain @gmail.com account. Enable 2-Step Verification on it:
#      https://myaccount.google.com/security
#   2. Generate an App Password (NOT your regular Gmail password):
#      https://myaccount.google.com/apppasswords
#      Select app "Mail", device "Other", name it "Izy's Sourdough", and copy the 16-character code.
#   3. Set SMTP_USER to the full Gmail address and SMTP_PASSWORD to the App Password
#      (remove spaces from the generated code).
#   4. EMAIL_FROM must match SMTP_USER for Gmail to accept the send.
#   5. In production, set these same values as secrets/env vars in your hosting provider
#      (e.g. Netlify/Vercel dashboard) — do NOT commit them or rely on .env.local, which is
#      not deployed.
#
# Without valid SMTP credentials, order confirmation emails will only be logged to the
# console instead of actually sent (see lib/email.ts). In production this now also logs
# a console.error so missing config is visible in server logs.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME="Izy's Sourdough"

# Admin new-order alert
# When a customer places an order, a plain-text summary is emailed to this
# address using the SMTP settings above. Leave unset to only log the event
# to the console (see lib/notifications.ts / lib/email.ts).
ADMIN_NOTIFICATION_EMAIL=your-personal-email@example.com

# Customer SMS (Twilio) — PAUSED
# SMS notifications are on hold for now. lib/sms.ts will silently no-op (log only) unless
# these are set, so it's safe to leave them unset. Revisit when SMS is prioritized again.
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15555550123

# Error tracking (Sentry)
# Create a free project at https://sentry.io (platform: Next.js) to get these values.
# NEXT_PUBLIC_SENTRY_DSN is used by the browser bundle; SENTRY_DSN is used server-side
# (they are usually the same DSN value). SENTRY_ORG/SENTRY_PROJECT/SENTRY_AUTH_TOKEN are
# only needed to upload source maps during `next build` (CI/production builds) — safe to
# leave unset for local development.
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token