
# Local SQLite database file used by Prisma
DATABASE_URL="file:./dev.db"

# Customer email (SMTP)
# For local development, copy these into .env.local (or .env) and fill in real values.
# .env.example is NOT loaded by Next.js and should never hold real credentials.
#
# Example for Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your-email@gmail.com
#   SMTP_PASSWORD=your-gmail-app-password
#   EMAIL_FROM=your-email@gmail.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-username
SMTP_PASSWORD=your-password
EMAIL_FROM=orders@izyssourdough.com
EMAIL_FROM_NAME="Izy's Sourdough"

# Customer SMS (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_FROM_NUMBER=+15555550123